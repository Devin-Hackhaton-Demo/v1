# Supabase projekt (https URL, a supabase-js kliensnek)
SUPABASE_URL=https://<project-ref>.supabase.co
# Publikus anon kulcs (RLS-sel védett kliensoldali hozzáférés)
SUPABASE_ANON_KEY=
# Service role kulcs — CSAK szerveroldalon/scriptekben, soha nem kerülhet UI bundle-be
SUPABASE_SERVICE_ROLE_KEY=
# Postgres kapcsolat migrációkhoz/típusgeneráláshoz (session pooler, IPv4-kompatibilis)
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# Seed tesztfelhasználók közös jelszava
DEMO_USER_PASSWORD=
