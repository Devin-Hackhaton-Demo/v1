# Supabase project (https URL of your project)
SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key (RLS-protected client access)
SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-side only, never ship to clients
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Postgres connection string — use the SESSION POOLER url (the direct db.<ref>.supabase.co host is IPv6-only)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres
# Password for the seeded demo users (owner@demo.test, member@demo.test)
DEMO_USER_PASSWORD=choose-a-demo-password
# Google OAuth app (MCP integrations workstream)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Anthropic chat proxy (POST /api/chat)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5
