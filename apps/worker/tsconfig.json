{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "types": ["node"],
    // The worker always runs from source via tsx (`npm run worker`), so only
    // declarations are emitted here. This also disables the relative-import
    // rewrite (TS2878): the `.ts` imports into packages/db resolve through
    // project references for type-checking and through tsx at runtime.
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../../packages/db" },
    { "path": "../../packages/domain" }
  ]
}
